server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    charset utf-8;
    absolute_redirect off;
    server_tokens off;

    # 共通のヘッダー・フッターを各ページに差し込む（_partials/ の中身）
    ssi on;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 512;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain application/xml;

    # 部品ファイルは直接は見せない
    location ^~ /_partials/ {
        internal;
    }

    # CSS / JS / ライブラリ（URL に ?v= を付けて更新を反映させる）
    location ^~ /assets/ {
        include /etc/nginx/headers.conf;
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    location = /404.html {
        internal;
        include /etc/nginx/headers.conf;
    }

    # /date-tools.html → /date-tools に統一
    location ~ ^(/.+)\.html$ {
        return 301 $1;
    }

    location = /index {
        return 301 /;
    }

    location / {
        include /etc/nginx/headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri.html $uri/index.html =404;
    }

    error_page 404 /404.html;
}
